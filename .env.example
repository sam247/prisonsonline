# Public site URL for canonical URLs, sitemap, and Open Graph (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://prisonsonline.com

# UK prison verifier production writes. Default off. Must be "1" AND pass --write.
# UK_PRISON_VERIFIER_WRITE=0

# US prison verifier production writes. Default off. Must be "1" AND pass --write.
# US_PRISON_VERIFIER_WRITE=0


# Completeness (empty-field SAFE_FILL) writes. Default off. Independent of VERIFY writes.
# Requires --completeness-write AND the matching env var = 1.
# UK_PRISON_COMPLETENESS_WRITE=0
# US_PRISON_COMPLETENESS_WRITE=0

# Optional raster tile provider. Configure URL and matching attribution together.
# Defaults to OpenStreetMap standard tiles; no API key required.
# NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
