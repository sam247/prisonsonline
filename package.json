    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "data:refresh:coordinates": "tsx scripts/refresh-prison-coordinates.ts",
    "audit:map": "tsx scripts/report-prison-map.ts",
    "data:build:au": "node scripts/build-au-prisons.mjs",
    "verify:au": "tsx scripts/verify-au-prisons.ts",
    "verify:au:live": "tsx scripts/verify-au-prisons.ts --live",
    "data:build:nz": "node scripts/build-nz-prisons.mjs",
    "verify:nz": "tsx scripts/verify-nz-prisons.ts",
    "verify:nz:live": "tsx scripts/verify-nz-prisons.ts --live",
    "data:build:ie": "node scripts/build-ie-prisons.mjs",
    "verify:ie": "tsx scripts/verify-ie-prisons.ts",
    "verify:ie:live": "tsx scripts/verify-ie-prisons.ts --live",
    "data:build:za": "node scripts/build-za-prisons.mjs",
    "verify:za": "tsx scripts/verify-za-prisons.ts",
    "verify:za:live": "tsx scripts/verify-za-prisons.ts --live"
  },
