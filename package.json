{
  "name": "prisonsonline",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "data:build": "node scripts/build-institutional-data.mjs",
    "data:build:us": "node scripts/build-us-prisons.mjs",
    "data:build:ca": "node scripts/build-ca-prisons.mjs",
    "data:build:courts": "node scripts/build-court-directory.mjs",
